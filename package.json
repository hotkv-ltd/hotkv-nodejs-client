{
  "name": "@hotkv/client",
  "version": "1.0.0",
  "description": "A high-performance Node.js client for HotKV, a RESP2/RESP3-compatible in-memory data store with built-in AI and LLM-serving features.",
  "keywords": [
    "hotkv",
    "resp",
    "resp3",
    "key-value",
    "cache",
    "database",
    "client",
    "pubsub",
    "cluster",
    "llm",
    "ai",
    "vercel-ai-sdk",
    "langchain"
  ],
  "license": "Apache-2.0",
  "author": "HotKV Ltd",
  "homepage": "https://hotkv.com",
  "bugs": {
    "url": "https://github.com/hotkv-ltd/hotkv-nodejs-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotkv-ltd/hotkv-nodejs-client.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      },
      "require": {
        "types": "./dist/ai.d.cts",
        "default": "./dist/ai.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "ai": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.12",
    "@types/node": "^20.14.0",
    "ai": "^7.0.114",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
